# TaskControl configuration.
# Copy to `.env` and edit. Every variable is optional; the defaults below are the
# built-in defaults. `.env` is gitignored — never commit real values.
#
# NEVER put a secret in this file. Secrets are referenced, not embedded
# (development/engineering/standards/22_RUNTIME_OBSERVABILITY_AND_SECURITY.md).

# local | development | staging | production
TASKCONTROL_ENVIRONMENT=local

# Verbose diagnostics. Must remain false in production.
TASKCONTROL_DEBUG=false

# DEBUG | INFO | WARNING | ERROR | CRITICAL
TASKCONTROL_LOG_LEVEL=INFO

# json | text — json in production, text is easier to read locally
TASKCONTROL_LOG_FORMAT=json

# Database and local artefacts.
TASKCONTROL_DATA_DIR=./data

# API bind address, used by `taskctl server`. Keep the loopback default unless you
# intend to expose the API.
TASKCONTROL_API_HOST=127.0.0.1
TASKCONTROL_API_PORT=8000
